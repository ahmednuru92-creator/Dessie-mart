## 🤖 7. የባክ-ኤንድ ዌብሁክ እና ቴሌግራም ቦት (`server/server.js`)

```javascript
const express = require('express');
const cors = require('cors');
const { Telegraf } = require('telegraf');

const app = express();
app.use(cors());
app.use(express.json());

const PORT = process.env.PORT || 4000;
const TELEGRAM_TOKEN = process.env.TELEGRAM_BOT_TOKEN || '7491029482:AAH920194kdfj02-48201kdf9201_live';
const TARGET_CHANNEL = process.env.TELEGRAM_TARGET_CHANNEL || '@DessieMarket';
const bot = new Telegraf(TELEGRAM_TOKEN);

app.post('/api/v1/payments/webhook', async (req, res) => {
  try {
    const { tradeStatus, outTradeNo, totalAmount, subjectPayload } = req.body;

    if (tradeStatus === 'SUCCESS') {
      const title = subjectPayload?.title || 'አዲስ ማስታወቂያ በደሴ ማርት';
      const price = Number(subjectPayload?.price || totalAmount).toLocaleString();
      const phone = subjectPayload?.phone || '0920044626';

      const caption = `🌟 አዲስ ማስታወቂያ በደሴ ማርት (ሙጋድ ገበያ)!\n\n📌 ${title}\n💰 ዋጋ: ${price} ብር\n📍 መገኛ: ደሴ / ወሎ\n📞 ስልክ: ${phone}\n\n👉 በደሴ ማርት መተግበሪያ ላይ ሙሉ መረጃውን ይመልከቱ!\n#ደሴ_ማርት #ሙጋድ_ገበያ`;

      await bot.telegram.sendMessage(TARGET_CHANNEL, caption).catch(console.error);

      return res.status(200).json({ code: 200, message: 'Payment verified and posted to @DessieMarket', txnId: outTradeNo });
    }

    return res.status(422).json({ code: 422, status: 'FAILED', allowRetry: true });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
});

app.listen(PORT, () => console.log(`🚀 Dessie Mart API & Bot running on port ${PORT}`));
```
